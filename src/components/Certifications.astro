---
import { Icon } from "astro-icon/components";
import { business } from "@/content/business";
---

<section class="bg-surface-0 py-20 lg:py-24">
  <div class="container-site">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <p class="eyebrow">Certified & Accredited</p>
      <h2 class="mt-3 text-3xl lg:text-4xl">ISO Certified for Quality You Can Trust</h2>
      <p class="mt-4 text-lg text-ink-600">
        TriasiaGlobal is independently certified by {business.certifyingBody} against international standards for
        quality management and translation services.
      </p>
    </div>

    <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2">
      {
        business.certifications.map((cert) => (
          <div class="card card-hover p-6">
            <div class="icon-badge">
              <Icon name={cert.icon} class="h-5 w-5" />
            </div>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-brass-700">{cert.standard}</p>
            <h3 class="mt-1 text-lg font-semibold text-ink-900">{cert.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{cert.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
interface Props {
  heading: string;
  links: Array<{ label: string; href: string }>;
  headingLevel?: "h2" | "h3";
}

const { heading, links, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="bg-surface-1 py-16 lg:py-20">
  <div class="container-site max-w-4xl">
    <Heading class="text-2xl lg:text-3xl">{heading}</Heading>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="card card-hover block p-4 text-sm font-medium text-navy-800">
              {link.label} →
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

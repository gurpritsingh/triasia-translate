---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "dark" | "light";
  compact?: boolean;
}

const { variant = "dark", compact = false } = Astro.props;

const badges = [
  { icon: "lucide:shield-check", label: "Certified & Sworn Translators" },
  { icon: "lucide:landmark", label: "Govt. & Embassy Accepted" },
  { icon: "lucide:lock", label: "100% Confidential" },
  { icon: "lucide:clock", label: "24–48 Hr Turnaround" },
  { icon: "lucide:award", label: "ISO 9001:2015 & 17100:2015 Certified" },
];
---

<ul
  class:list={[
    "flex flex-wrap gap-2",
    compact ? "gap-x-2.5" : "gap-x-3",
  ]}
>
  {
    badges.map((badge) => (
      <li
        class:list={[
          "chip-stamp text-xs font-medium",
          variant === "dark" ? "border-white/25 text-white/85" : "border-navy-800/25 text-ink-600",
        ]}
      >
        <Icon
          name={badge.icon}
          class:list={["h-3.5 w-3.5 shrink-0", variant === "dark" ? "text-brass-300" : "text-seal-600"]}
        />
        <span>{badge.label}</span>
      </li>
    ))
  }
</ul>

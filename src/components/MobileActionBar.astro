---
import { Icon } from "astro-icon/components";
import { business, whatsappUrl } from "@/content/business";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-white/95 shadow-[0_-8px_20px_-8px_rgb(16_24_40_/_0.12)] backdrop-blur [padding-bottom:env(safe-area-inset-bottom)] md:hidden"
>
  <a href={`tel:${business.phone}`} class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-navy-800">
    <Icon name="lucide:phone" class="h-5 w-5" />
    <span class="text-[11px] font-semibold">Call</span>
  </a>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center gap-0.5 border-x border-line py-2.5 text-[#128C7E]"
  >
    <Icon name="lucide:message-circle" class="h-5 w-5" />
    <span class="text-[11px] font-semibold">WhatsApp</span>
  </a>
  <a href={`mailto:${business.email}`} class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-brass-700">
    <Icon name="lucide:mail" class="h-5 w-5" />
    <span class="text-[11px] font-semibold">Get Quote</span>
  </a>
</div>

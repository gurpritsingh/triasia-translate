---
import { Icon } from "astro-icon/components";
import { business } from "@/content/business";
import TrustBar from "@/components/TrustBar.astro";
import StarRating from "@/components/StarRating.astro";
import Seal from "@/components/Seal.astro";

const stats = [
  { number: "500+", label: "Happy Clients" },
  { number: "10K+", label: "Documents" },
  { number: "5.0", label: "Rating" },
];

const docLines = ["w-full", "w-11/12", "w-4/5", "w-full", "w-2/3"];
---

<section
  class="bg-navy-950 text-white [background-image:radial-gradient(ellipse_at_top_right,rgb(200_162_75/0.10),transparent_55%)]"
>
  <div class="container-site grid items-center gap-12 py-20 lg:grid-cols-2 lg:py-24">
    <div>
      <p class="eyebrow flex items-center gap-2 text-brass-300">
        <Icon name="lucide:badge-check" class="h-4 w-4" />
        India's Leading Translation Service
      </p>

      <div class="mt-4">
        <StarRating variant="dark" />
      </div>

      <h1 class="mt-4 text-4xl text-white lg:text-5xl xl:text-[3.25rem]">
        Certified <span class="text-brass-300">Translation &amp; Interpretation</span> Services in India
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-white/75">
        TriAsiaGlobal is a leading certified translation and interpretation agency in India, trusted nationwide for
        delivering precise, government-recognized, and internationally accepted translations.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-white/75">
        We specialize in authorized document translation for individuals, corporations, and government bodies. Our team
        of certified translators and native language experts ensures accuracy, cultural sensitivity, and compliance
        with official requirements.
      </p>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={`mailto:${business.email}`} class="btn-brass px-8 py-3.5 text-base">Start Your Translation</a>
        <a
          href="/locations/"
          class="inline-flex items-center justify-center rounded-[0.4rem] border border-white/25 px-8 py-3.5 text-base font-medium text-white transition-colors hover:border-white/60"
        >
          Browse Locations
        </a>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6">
        <TrustBar variant="dark" />
      </div>

      <div class="mt-8 flex divide-x divide-white/15">
        {
          stats.map((stat) => (
            <div class="px-6 first:pl-0">
              <div class="font-display text-3xl font-semibold text-white">{stat.number}</div>
              <div class="mt-1 text-sm text-white/60">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Signature visual: a mocked "certified true translation" document,
        stamped with the seal mark — stands in for generic stock photography
        and doubles as a legible artifact of what the business delivers. */}
    <div class="relative hidden lg:block">
      <div class="chip-stamp absolute -left-4 -top-4 z-10 border-brass-300 bg-navy-950 text-xs font-semibold text-brass-300">
        <Icon name="lucide:zap" class="h-3.5 w-3.5" />
        24/7 Support
      </div>

      <div class="rotate-2 rounded-2xl border border-white/15 bg-surface-0 p-8 shadow-2xl">
        <div class="flex items-center justify-between border-b border-line pb-4">
          <span class="eyebrow">Certified Translation</span>
          <Icon name="lucide:file-check-2" class="h-5 w-5 text-navy-800" />
        </div>

        <div class="mt-6 space-y-2.5">
          {docLines.map((width) => <div class={`h-2.5 rounded-full bg-line ${width}`} />)}
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {["English", "한국어", "中文", "हिन्दी"].map((lang) => (
            <span class="rounded-full border border-line bg-surface-1 px-2.5 py-1 text-xs font-medium text-ink-600">
              {lang}
            </span>
          ))}
        </div>

        <div class="mt-8 flex items-end justify-between border-t border-line pt-5">
          <div>
            <p class="text-xs font-medium text-ink-600">Authorized by</p>
            <svg width="90" height="24" viewBox="0 0 90 24" aria-hidden="true" class="mt-1 text-navy-800">
              <path
                d="M2 18 C 10 4, 16 22, 24 10 S 38 2, 44 14 S 58 20, 64 8 S 78 4, 88 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <p class="font-display text-sm text-ink-600">{new Date().getFullYear()}</p>
        </div>
      </div>

      <Seal size={116} class="absolute -bottom-6 -right-6 drop-shadow-lg" />
    </div>
  </div>
</section>

---
import { Icon } from "astro-icon/components";

interface Props {
  faqs: Array<{ question: string; answer: string }>;
  headingLevel?: "h2" | "h3";
}

const { faqs, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="bg-surface-0 py-16 lg:py-20">
  <div class="container-site max-w-3xl">
    <Heading class="text-2xl lg:text-3xl">Frequently Asked Questions</Heading>
    <div class="mt-6 divide-y divide-line border-t border-line">
      {
        faqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink-900 [&::-webkit-details-marker]:hidden">
              {faq.question}
              <Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cities } from "@/content/cities";
import { buildStaticSeo } from "@/content/seo";

const seo = buildStaticSeo({
  title: "Translation & Interpretation Services Across India | TriasiaGlobal",
  description:
    "Browse TriasiaGlobal's certified translator and interpreter services by city across India, covering Hindi, Punjabi, Kannada, Korean, and more.",
  path: "/locations/",
});
---

<BaseLayout {...seo}>
  <section class="hero-light py-20 lg:py-24">
    <div class="container-site">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <p class="eyebrow">Locations</p>
        <h1 class="mt-3 text-3xl lg:text-4xl">Our Locations Across India</h1>
        <p class="mt-4 text-lg text-ink-600">
          Certified translation and interpretation services available in the following cities.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          cities.map((city) => (
            <a href={`/locations/${city.slug}/`} class="card card-hover group block p-6">
              <div class="flex items-center gap-3">
                <div class="icon-badge">
                  <Icon name="lucide:map-pin" class="h-5 w-5" />
                </div>
                <div>
                  <h2 class="font-display text-xl font-semibold text-ink-900 transition-colors group-hover:text-navy-800">
                    {city.name}
                  </h2>
                  <p class="text-sm text-ink-600">{city.state}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

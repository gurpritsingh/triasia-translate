---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cities } from "@/content/cities";
import { languages } from "@/content/languages";
import { services } from "@/content/services";
import { buildStaticSeo } from "@/content/seo";
import { business } from "@/content/business";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;

const availableLanguages = languages.filter(
  (language) => !city.languages || city.languages.includes(language.slug)
);

const seo = buildStaticSeo({
  title: `Translator & Interpreter Services in ${city.name} | TriasiaGlobal`,
  description: availableLanguages.length
    ? `Certified translation and interpretation services in ${city.name}, ${city.state} across ${availableLanguages.length} languages, including ${availableLanguages
        .slice(0, 3)
        .map((language) => language.name)
        .join(", ")}.`
    : `Certified translation and interpretation services for ${city.name}, ${city.state}. Contact TriasiaGlobal for government-accepted translators and interpreters.`,
  path: `/locations/${city.slug}/`,
});
---

<BaseLayout {...seo}>
  <section class="py-20 lg:py-24">
    <div class="container-site">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <nav aria-label="Breadcrumb" class="eyebrow">
          <a href="/locations/" class="transition-colors hover:text-navy-800">Locations</a>
          <span class="mx-2 text-line">/</span>
          <span>{city.name}</span>
        </nav>
        <h1 class="mt-3 text-3xl lg:text-4xl">
          Translation &amp; Interpretation Services in {city.name}
        </h1>
        <p class="mt-4 text-lg text-ink-600">
          {
            availableLanguages.length
              ? `Serving ${city.name}, ${city.state}, across ${availableLanguages.length} languages.`
              : `Serving ${city.name}, ${city.state}. Get in touch for certified translators and interpreters in any of our supported languages.`
          }
        </p>
      </div>

      {
        availableLanguages.length === 0 && (
          <div class="mx-auto max-w-2xl text-center">
            <p class="text-ink-600">
              We cover {city.name} through our national translation and interpretation teams. Browse
              our <a href="/locations/" class="text-navy-800 hover:underline">other locations</a>, or
              contact us directly and we will arrange a certified translator or interpreter.
            </p>
            <a href={`mailto:${business.email}`} class="btn-primary mt-6">Get a Quote</a>
          </div>
        )
      }

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          availableLanguages.map((language) => (
            <div class="card card-hover p-6">
              <h2 class="font-display text-xl font-semibold text-ink-900">
                {language.name}
                {language.nativeName && <span class="ml-2 text-sm font-normal text-ink-600">{language.nativeName}</span>}
              </h2>
              <ul class="mt-3 space-y-1.5">
                {services.map((service) => (
                  <li>
                    <a
                      href={`/${city.slug}/${language.slug}/${service.slug}/`}
                      class="text-sm text-navy-800 hover:underline"
                    >
                      {language.name} {service.label} in {city.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

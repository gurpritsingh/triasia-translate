---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ServicesGrid from "@/components/ServicesGrid.astro";
import LanguagesSection from "@/components/LanguagesSection.astro";
import WhyChooseUs from "@/components/WhyChooseUs.astro";
import Certifications from "@/components/Certifications.astro";
import { buildStaticSeo } from "@/content/seo";
import { business } from "@/content/business";
import { languages } from "@/content/languages";

const seo = buildStaticSeo({
  title: "Certified Translation Services in India | TriasiaGlobal",
  description:
    "Certified translation and interpretation across India — legal, academic, medical, technical and personal documents, with apostille attestation. ISO certified.",
  path: "/",
  jsonLd: {
    "@context": "https://schema.org",
    "@graph": [
      {
        // ProfessionalService is a LocalBusiness subtype: same local signals, more
        // specific about what the business does. `@id` is the canonical node other
        // pages' provider blocks resolve to.
        "@type": "ProfessionalService",
        "@id": `${business.siteUrl}/#business`,
        name: business.name,
        url: business.siteUrl,
        image: `${business.siteUrl}/og-image.jpg`,
        telephone: business.phone,
        email: business.email,
        address: { "@type": "PostalAddress", ...business.address },
        areaServed: { "@type": "Country", name: "India" },
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            opens: business.hours.opens,
            closes: business.hours.closes,
          },
        ],
        sameAs: Object.values(business.social),
        knowsLanguage: languages.map((language) => language.name),
        hasCredential: business.certifications.map((cert) => ({
          "@type": "EducationalOccupationalCredential",
          credentialCategory: "certification",
          name: `${cert.standard} — ${cert.name}`,
          recognizedBy: { "@type": "Organization", name: business.certifyingBody },
        })),
      },
      {
        "@type": "WebSite",
        "@id": `${business.siteUrl}/#website`,
        url: business.siteUrl,
        name: business.name,
        publisher: { "@id": `${business.siteUrl}/#business` },
      },
    ],
  },
});
---

<BaseLayout {...seo}>
  <Hero />
  <ServicesGrid />
  <LanguagesSection />
  <WhyChooseUs />
  <Certifications />
</BaseLayout>

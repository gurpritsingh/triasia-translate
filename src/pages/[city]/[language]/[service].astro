---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceHero from "@/components/ServiceHero.astro";
import ServiceContent from "@/components/ServiceContent.astro";
import ServicesGrid from "@/components/ServicesGrid.astro";
import { cityLanguagePairs } from "@/content/routes";
import { resolveContent } from "@/content/resolveContent";
import { buildServiceSeo } from "@/content/seo";

export function getStaticPaths() {
  return cityLanguagePairs().map(({ city, language, service }) => ({
    params: { city: city.slug, language: language.slug, service: service.slug },
    props: { city, language, service },
  }));
}

const { city, language, service } = Astro.props;

const content = resolveContent({ city, language, service });
const seo = buildServiceSeo({
  city,
  language,
  service,
  content,
  // Alias cities (Gurugram) canonicalise to their target (Gurgaon) so the two
  // URL sets consolidate instead of competing as duplicates.
  path: `/${city.aliasOf ?? city.slug}/${language.slug}/${service.slug}/`,
});
---

<BaseLayout {...seo}>
  <ServiceHero
    heading={content.heading}
    subHeading={content.subHeading}
    crumbs={[
      { label: "Home", href: "/" },
      { label: city.name, href: `/locations/${city.slug}/` },
      { label: `${language.name} ${service.label}` },
    ]}
  />
  <ServiceContent sections={content.sections} languagePairs={content.languagePairs} faq={content.faq} />

  <section class="bg-surface-0 py-10">
    <div class="container-site max-w-4xl flex flex-wrap gap-x-8 gap-y-3">
      <a href={`/${language.slug}/${service.slug}/`} class="text-sm font-medium text-navy-800 hover:underline">
        {language.name} {service.label.toLowerCase()} services across India →
      </a>
      <a href={`/locations/${city.aliasOf ?? city.slug}/`} class="text-sm font-medium text-navy-800 hover:underline">
        All languages available in {city.name} →
      </a>
    </div>
  </section>

  <ServicesGrid headingLevel="h2" />
</BaseLayout>

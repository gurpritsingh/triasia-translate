---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildStaticSeo } from "@/content/seo";

const seo = buildStaticSeo({
  title: "404 - Page Not Found | TriasiaGlobal",
  description: "The page you're looking for doesn't exist.",
  path: "/404/",
});
---

<BaseLayout {...seo} noindex>
  <section class="flex min-h-[60vh] items-center justify-center py-20">
    <div class="text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-5xl">Page not found</h1>
      <p class="mt-4 text-lg text-ink-600">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn-primary mt-8">Return to Home</a>
    </div>
  </section>
</BaseLayout>
